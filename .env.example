# From `supabase status` after `supabase start` (ports vary per machine)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8785
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Optional aliases (server-only fallbacks)
SUPABASE_URL=http://127.0.0.1:8785
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
